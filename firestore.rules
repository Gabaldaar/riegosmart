rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dispositivos/{chipId} {
      // Regla de seguridad: Permite lectura y escritura si el usuario está autenticado
      allow read, write: if request.auth != null;
      
      // Regla para la subcolección de logs de eventos
      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
