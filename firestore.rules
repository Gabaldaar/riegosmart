rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Colección de dispositivos ──────────────────────────────────────────────
    match /dispositivos/{chipId} {

      function estaAutenticado() {
        return request.auth != null;
      }
      function esElPropietario() {
        return estaAutenticado() &&
               resource.data.owner_uid == request.auth.uid;
      }
      function sinPropietario() {
        return !('owner_uid' in resource.data) ||
               resource.data.owner_uid == null;
      }

      // LECTURA: cualquier usuario autenticado puede leer configuración del dispositivo.
      // La seguridad real está en el token MQTT (sólo quien tiene el token puede enviar comandos).
      allow read: if estaAutenticado();

      // CREACIÓN: cualquier usuario autenticado (primer setup del dispositivo)
      allow create: if estaAutenticado();

      // MODIFICACIÓN: propietario o equipo sin reclamar
      allow update: if estaAutenticado() && (sinPropietario() || esElPropietario());

      // BORRADO: solo el propietario
      allow delete: if esElPropietario();

      // Sub-colección de logs: solo el propietario
      match /logs/{logId} {
        allow read, write: if estaAutenticado() &&
          get(/databases/$(database)/documents/dispositivos/$(chipId)).data.owner_uid
            == request.auth.uid;
      }

      // Sub-colección de eventos para alertas y notificaciones push
      match /eventos/{eventId} {
        allow read, write: if estaAutenticado() &&
          get(/databases/$(database)/documents/dispositivos/$(chipId)).data.owner_uid
            == request.auth.uid;
      }
    }

    // ── Colección de usuarios (vínculo cuenta → dispositivo + FCM tokens + preferencias) ──
    // Cada usuario solo puede leer y escribir su propio documento y sus subcolecciones (fcm_tokens, config_notificaciones)
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

  }
}
